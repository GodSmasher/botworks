# ─────────────────────────────────────────────────────────────────────────────
# botworks — environment template
#
# Nothing here is needed for the demo. With no .env the bots answer offline,
# the queue runs in memory and the admin panel reads fixture tables.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. Anything other than "false" keeps mock mode on.
BOTWORKS_MOCK=true

# ── AI provider ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Job queue ────────────────────────────────────────────────────────────────
# Leave empty for the in-memory queue. `docker compose up -d` starts Redis.
REDIS_URL=

# ── API server ───────────────────────────────────────────────────────────────
API_PORT=4000
# Empty = no auth (development). Set it to require X-API-Key on /api/*.
API_SECRET=

# ── Admin panel ──────────────────────────────────────────────────────────────
BOTWORKS_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
